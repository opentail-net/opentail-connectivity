<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
    <IsPackable>false</IsPackable>
    <Description>The work queue conformance suite against a real RabbitMQ. Skipped unless OTAIL_QUEUE_RABBITMQ is set; run by queues-rabbitmq.yml.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../OpenTail.Connectivity.Queues.RabbitMQ/OpenTail.Connectivity.Queues.RabbitMQ.csproj" />
  </ItemGroup>
</Project>
