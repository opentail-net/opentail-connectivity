<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the pins below lift vulnerable transitive packages. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.4.0" />
    <!-- Tests only: the VectorData adapter is proven against the in-memory connector (preview). -->
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.InMemory" Version="1.74.0-preview" />
    <!-- Tests only: OpenTail.Connectivity.Tests.PgVector, run by memory-pgvector.yml against a real server. -->
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.PgVector" Version="1.74.0-preview" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageVersion Include="Google.Apis.Calendar.v3" Version="1.68.0.3592" />
    <PackageVersion Include="Ical.Net" Version="4.3.1" />
    <PackageVersion Include="Google.Apis.Gmail.v1" Version="1.74.0.4162" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Graph" Version="6.2.0" />
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0-pre.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.0-pre.108" />
    <PackageVersion Include="Transformations.Text" Version="2.0.3" />
    <!-- Transitive pin for GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 (fixed in 10.0.13). Microsoft.Data.Sqlite 10.0.13 already brings SQLitePCLRaw past GHSA-2m69-gcr7-jv3q. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
