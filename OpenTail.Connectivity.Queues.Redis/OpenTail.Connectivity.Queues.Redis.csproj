<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>OpenTail Connectivity — Redis/Valkey queue control: IQueueControl shared by every worker of a queue across machines (concurrency slots, circuits, rate starts, cancellations), in atomic Lua scripts on the server's clock. Works with Redis and Valkey. Verification: Tested.</Description>
    <PackageTags>opentail;connectivity;queue;work-queue;redis;valkey</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <InternalsVisibleTo Include="OpenTail.Connectivity.Tests.Redis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenTail.Connectivity.Queues/OpenTail.Connectivity.Queues.csproj" />
  </ItemGroup>
</Project>
